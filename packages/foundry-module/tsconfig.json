{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@league-of-foundry-developers/foundry-vtt-types"],
    "paths": {
      "@foundry-mcp/shared": ["../../shared/src"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  // `src/__fixtures__` is test-only scaffolding (the shared fake Foundry world),
  // excluded for the same reason as `*.test.*`: this config EMITS into `dist`, and
  // installer/build-nsis.js copies `dist` recursively into the shipped module, so
  // anything left in here rides along into a user's Foundry install.
  // It does typecheck cleanly under this config — to re-verify, drop the
  // `src/__fixtures__/**` entry below and run `npm run typecheck`.
  "exclude": ["dist", "**/*.test.*", "**/*.spec.*", "src/__fixtures__/**"]
}
